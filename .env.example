# ============================================================
# MarketTracker — пример переменных окружения.
# Скопируйте этот файл в `.env` и заполните значения.
#   cp .env.example .env
# ============================================================

# Telegram-токен бота (получить у @BotFather)
BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample

# Прокси для Telegram API (если api.telegram.org блокируется провайдером).
# Примеры: http://user:pass@host:port  или  socks5://user:pass@host:port
TELEGRAM_PROXY_URL=

# URL базы данных (SQLAlchemy async)
DB_URL=sqlite+aiosqlite:///data/market_tracker.db

# Интервал фоновой проверки цен, в минутах
SCHEDULER_INTERVAL_MINUTES=15

# HTTP-клиент парсеров
REQUEST_TIMEOUT_SECONDS=15.0
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Прокси для парсеров (обход IP-блокировок маркетплейсов). Оставьте пустым, если запускаете с домашнего IP.
PARSER_PROXY_URL=

# Логирование (loguru)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# Минимальный интервал между повторными алертами по одному треку, в часах
ALERT_COOLDOWN_HOURS=24
